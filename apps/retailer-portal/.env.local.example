# Retailer portal — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local.
#
# ── Local development ─────────────────────────────────────────────────────────
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>   (printed by `supabase start`)
#   SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
#   NEXT_PUBLIC_APP_URL=http://localhost:3001
#
# ── Staging / Production ──────────────────────────────────────────────────────
#   Values come from Supabase dashboard → Project Settings → API.
#   NEXT_PUBLIC_APP_URL is the deployed portal URL (used for Stripe redirect).

# Public — safe to expose to the browser (Next.js client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The deployed URL of this portal — used for Stripe success/cancel redirects.
# Local: http://localhost:3001   Staging: https://staging-portal.betterofflocal.co.uk
NEXT_PUBLIC_APP_URL=https://portal.betterofflocal.co.uk

# Server-side only — NEVER expose to browser or commit to git.
# SUPABASE_URL: server-side project URL used by the service-role client.
# Must be set alongside NEXT_PUBLIC_SUPABASE_URL — they point to the same project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (retailer portal does not call Stripe directly) ───────────────────
# Stripe checkout is initiated via the create-retailer-checkout-session edge
# function, which holds the Stripe secret key as a Supabase secret.
# No STRIPE_* vars are required here.
#
# ── Stripe test card ─────────────────────────────────────────────────────────
# Use during checklist step 4 (retailer billing activation):
#   Number:  4242 4242 4242 4242
#   Expiry:  any future date
#   CVC:     any 3 digits
#   ZIP:     any value
