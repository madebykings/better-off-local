# Admin portal — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local.
#
# ── Local development ─────────────────────────────────────────────────────────
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>   (printed by `supabase start`)
#   SUPABASE_URL=http://localhost:54321
#   SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
#
# ── Staging / Production ──────────────────────────────────────────────────────
#   Values come from Supabase dashboard → Project Settings → API.
#   Admin access is controlled by profiles.role = 'admin' (set via seed script
#   or: UPDATE profiles SET role = 'admin' WHERE email = '...').

# Public — safe to expose to the browser (Next.js client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER expose to browser or commit to git.
# Both vars point to the same project; SUPABASE_URL is used by the server-side
# client initialiser, NEXT_PUBLIC_SUPABASE_URL by the browser client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
