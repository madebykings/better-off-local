# Flutter mobile app — environment variables
#
# Flutter does not use dotenv files at runtime. All values are injected at
# build time via --dart-define flags. This file documents every required
# variable; copy the relevant block into your IDE run configuration or build
# script and fill in the values.
#
# ── Local development ─────────────────────────────────────────────────────────
#
#   flutter run \
#     --dart-define=SUPABASE_URL=http://localhost:54321 \
#     --dart-define=SUPABASE_ANON_KEY=<local-anon-key> \
#     --dart-define=GOOGLE_MAPS_API_KEY=<dev-key> \
#     --dart-define=HOME_DISCOVERY_RADIUS_KM=50
#
# ── Staging ───────────────────────────────────────────────────────────────────
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<staging-project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<staging-anon-key> \
#     --dart-define=GOOGLE_MAPS_API_KEY=<staging-maps-key> \
#     --dart-define=HOME_DISCOVERY_RADIUS_KM=25
#
# ── Production build ──────────────────────────────────────────────────────────
#
#   flutter build ipa \
#     --dart-define=SUPABASE_URL=https://<prod-project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<prod-anon-key> \
#     --dart-define=GOOGLE_MAPS_API_KEY=<prod-maps-key> \
#     --dart-define=HOME_DISCOVERY_RADIUS_KM=25
#
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL and anon key.
# Local: http://localhost:54321 — anon key printed by `supabase start`.
# Staging/Prod: Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Maps API key — required for the map discovery screen.
# Restrict to your app bundle ID / package name in Google Cloud Console.
# An unrestricted key is acceptable for local emulator testing.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Discovery radius in km. Retailers further than this from the device are
# filtered out of the home screen. Default: 25.
# Use 50 locally to see all seed retailers regardless of simulated location.
HOME_DISCOVERY_RADIUS_KM=25

# ── Deep link / native config (NOT --dart-define) ────────────────────────────
#
# The custom URL scheme is configured in native files, not via --dart-define.
# These must match APP_SCHEME / APP_UNIVERSAL_LINK_DOMAIN in Supabase secrets.
#
# Android — apps/mobile/android/app/src/main/AndroidManifest.xml:
#   <intent-filter>
#     <data android:scheme="betterofflocal" android:host="subscription-success" />
#   </intent-filter>
#
# iOS — apps/mobile/ios/Runner/Info.plist:
#   <key>CFBundleURLSchemes</key>
#   <array><string>betterofflocal</string></array>
#
# Universal Links (production only):
#   Host apple-app-site-association at https://app.betterofflocal.co.uk/.well-known/
#   Add associated domain in Xcode: applinks:app.betterofflocal.co.uk
#
# ── Stripe test card ─────────────────────────────────────────────────────────
#
# Use during checklist steps 4 (retailer billing) and 5 (consumer membership):
#   Number:  4242 4242 4242 4242
#   Expiry:  any future date
#   CVC:     any 3 digits
#   ZIP:     any value
