# Supabase edge function secrets
#
# These are NOT dotenv files loaded at runtime. They are set per-environment
# via the Supabase CLI:
#
#   supabase secrets set KEY=value --project-ref <ref>
#
# Or in bulk from a local file (never commit the actual file):
#
#   supabase secrets set --env-file supabase/functions/.env.local
#
# This file documents every secret required. Copy to .env.local (gitignored)
# and fill in values before running `supabase secrets set`.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase runtime — do not set them manually.
#
# ── Deployment order ─────────────────────────────────────────────────────────
# 1. Create Supabase project and apply migrations (supabase db push --linked)
# 2. Create Stripe products and prices (test mode for staging, live for prod)
#    — note the three price IDs below
# 3. Set secrets via: supabase secrets set --env-file supabase/functions/.env.local
# 4. Deploy functions: supabase functions deploy
# 5. Register Stripe webhook endpoint in Stripe dashboard:
#    URL: https://<project-ref>.supabase.co/functions/v1/stripe-webhook
#    Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#            customer.subscription.deleted
# 6. Copy the webhook signing secret from Stripe dashboard into STRIPE_WEBHOOK_SECRET
# 7. Re-run: supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# 8. Create auth users and run seed script (supabase/seed/staging_seed.sql)
# 9. Deploy portals with correct .env.local values
# 10. Build Flutter app with staging --dart-define values
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key.
# Staging: sk_test_...   Production: sk_live_...
# Supabase dashboard → Project Settings → API → never use the publishable key here.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe webhook signing secret — generated when you register the webhook endpoint
# in the Stripe dashboard. Different per environment.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Consumer membership price IDs.
# Create these in Stripe dashboard → Products → Add product → "BOL Membership".
# Add two prices: monthly recurring and annual recurring.
STRIPE_PRICE_ID_MONTHLY=price_your-consumer-monthly-price-id
STRIPE_PRICE_ID_ANNUAL=price_your-consumer-annual-price-id

# Retailer listing plan price ID.
# Create in Stripe dashboard → Products → Add product → "BOL Retailer Listing".
# Add one price: annual recurring (e.g. £79.99/year).
STRIPE_RETAILER_ANNUAL_PRICE_ID=price_your-retailer-annual-price-id

# ── App deep link ─────────────────────────────────────────────────────────────

# Custom URL scheme used for Stripe success/cancel redirects back to the app.
# Must match CFBundleURLSchemes (iOS) and intent-filter scheme (Android).
# Default value if not set: betterofflocal
APP_SCHEME=betterofflocal

# Universal link domain (production only). When set, the checkout session uses
# https://<domain>/subscription-success instead of the custom scheme.
# Leave unset on staging to use the custom scheme fallback.
# APP_UNIVERSAL_LINK_DOMAIN=app.betterofflocal.co.uk

# ── Portal URLs ───────────────────────────────────────────────────────────────

# Retailer portal base URL — used for Stripe checkout success/cancel redirects.
# Local: http://localhost:3001   Staging: https://staging-portal.betterofflocal.co.uk
RETAILER_PORTAL_URL=https://portal.betterofflocal.co.uk

# ── Retailer subscription grace period ───────────────────────────────────────

# Number of days a retailer subscription can be past_due before the listing
# is hidden. Set to 0 on staging so payment failures are reflected immediately.
# Recommended production value: 3.
RETAILER_GRACE_DAYS=0
