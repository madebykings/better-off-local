{
  "name": "better-off-local",
  "private": true,
  "workspaces": [
    "apps/retailer-portal",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev:retailer": "turbo run dev --filter=retailer-portal",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.0.0"
}
